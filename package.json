{
  "name": "homelab-manager",
  "private": true,
  "type": "module",
  "workspaces": ["agent"],
  "scripts": {
    "dev": "vite dev --port 3000",
    "dev:demo": "cross-env VITE_DEMO_MODE=true vite dev --port 3000",
    "dev:demo:host": "cross-env VITE_DEMO_MODE=true vite dev --port 3000 --host",
    "dev:host": "vite dev --port 3000 --host",
    "typecheck": "tsc --noEmit",
    "build": "bun run typecheck && vite build",
    "build:demo": "bun run typecheck && cross-env VITE_DEMO_MODE=true vite build",
    "preview": "vite preview",
    "test": "cross-env-shell \"bun test --coverage 2>&1 | node scripts/check-coverage.js\"",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "test:coverage:check": "node scripts/check-coverage.js",
    "worker": "bun src/worker/collector.ts",
    "dev:local:up": "docker compose -f docker-compose.local.yml up -d --build",
    "dev:local:down": "docker compose -f docker-compose.local.yml down",
    "dev:local:restart": "docker compose -f docker-compose.local.yml up -d --force-recreate",
    "dev:local:rebuild": "docker compose -f docker-compose.local.yml down && docker compose -f docker-compose.local.yml build --no-cache && docker compose -f docker-compose.local.yml up -d",
    "dev:local:wipe": "docker compose -f docker-compose.local.yml down -v",
    "dev:local:logs": "docker compose -f docker-compose.local.yml logs -f",
    "dev:local:logs:worker": "docker compose -f docker-compose.local.yml logs -f worker",
    "dev:local:logs:db": "docker compose -f docker-compose.local.yml logs -f postgres",
    "dev:local:logs:agent": "docker compose -f docker-compose.local.yml logs -f agent",
    "dev:docker:up": "docker compose -f docker-compose.dev.yml up -d --build && docker compose -f docker-compose.dev.yml logs -f",
    "dev:docker:down": "docker compose -f docker-compose.dev.yml down",
    "dev:docker:restart": "docker compose -f docker-compose.dev.yml down && docker compose -f docker-compose.dev.yml up -d --build",
    "dev:docker:rebuild": "docker compose -f docker-compose.dev.yml down && docker compose -f docker-compose.dev.yml build --no-cache && docker compose -f docker-compose.dev.yml up -d && docker compose -f docker-compose.dev.yml logs -f",
    "dev:docker:wipe": "docker compose -f docker-compose.dev.yml down -v",
    "icons:download": "bun scripts/download-icons.ts",
    "schema:download": "bun scripts/download-compose-schema.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/inter": "^5.2.8",
    "@monaco-editor/react": "^4.7.0",
    "@mui/material": "^7.3.9",
    "@mui/x-date-pickers": "^8.27.2",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-devtools": "^0.7.11",
    "@tanstack/react-query": "^5.94.5",
    "@tanstack/react-router": "^1.168.2",
    "@tanstack/react-router-devtools": "^1.166.11",
    "@tanstack/react-router-ssr-query": "^1.166.10",
    "@tanstack/react-start": "^1.167.3",
    "@tanstack/react-virtual": "^3.13.23",
    "@tanstack/router-plugin": "^1.167.3",
    "@testing-library/react-hooks": "^8.0.1",
    "@types/dockerode": "^4.0.1",
    "@types/ssh2": "^1.15.5",
    "@types/ssh2-streams": "^0.1.13",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dayjs": "^1.11.20",
    "dockerode": "^4.0.10",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.6",
    "isomorphic-git": "^1.37.4",
    "jotai": "^2.18.1",
    "js-yaml": "^4.1.1",
    "lucide-react": "^0.561.0",
    "monaco-editor": "^0.55.1",
    "monaco-yaml": "^5.4.1",
    "nitro": "npm:nitro-nightly@latest",
    "pg": "^8.20.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "simplex-noise": "^4.0.3",
    "ssh2": "^1.17.0",
    "tailwindcss": "^4.2.2",
    "vite-tsconfig-paths": "^6.1.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.8.4",
    "@tanstack/devtools-vite": "^0.3.12",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.11",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.19.15",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "cross-env": "^10.1.0",
    "typescript": "^5.9.3",
    "undici": "^7.24.5",
    "vite": "^7.3.1",
    "vitest": "^3.2.4",
    "web-vitals": "^5.1.0"
  }
}