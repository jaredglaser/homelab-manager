# See docs/development.md for full setup instructions.

# PostgreSQL
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
POSTGRES_DB="homelab"
POSTGRES_USER="homelab"
POSTGRES_PASSWORD="changeme"
POSTGRES_SSL="false"
# Verify the PostgreSQL server's TLS certificate when POSTGRES_SSL is enabled.
# Defaults to "true". Set to "false" ONLY for self-signed certificates: this
# disables chain validation and exposes the connection to MITM attacks.
POSTGRES_SSL_REJECT_UNAUTHORIZED="true"
POSTGRES_POOL_SIZE="10"

# Web Server
WEB_PORT="3000"

# Background Worker
WORKER_ENABLED="true"
WORKER_DOCKER_ENABLED="true"
WORKER_ZFS_ENABLED="false"
WORKER_PROXMOX_ENABLED="false"
WORKER_COLLECTION_INTERVAL_MS="1000"

# Docker monitoring: configure hosts via Settings → Managed Hosts in the web UI
# (deploy the agent container on each host, then register the agent URL + token).

# Proxmox VE API
# Token format: USER@REALM!TOKENID (e.g., root@pam!monitoring)
# PROXMOX_HOST=""
# PROXMOX_PORT="8006"
# PROXMOX_TOKEN_ID=""
# PROXMOX_TOKEN_SECRET=""
# PROXMOX_ALLOW_SELF_SIGNED="true"

# Docker Stack Management
GIT_REPOS_DIR="./data/repos"
GIT_SERVER_TOKEN="dev-git-token"

# Deploy watchdog: fails deploys stuck in "in_progress" past the threshold.
# DEPLOY_WATCHDOG_INTERVAL_MS="120000"
# DEPLOY_WATCHDOG_TIMEOUT_MINUTES="10"

# Master encryption key for stack secrets and per-agent keypairs.
# Generate with: openssl rand -base64 32
# Either MASTER_KEY (inline base64) or MASTER_KEY_FILE (path to a file with base64) must be set.
MASTER_KEY=""
# MASTER_KEY_FILE="/var/lib/homelab-manager/master.key"

# Local-dev-only seeder: provisions a "localhost" managed host and dev keypair on first run.
# Agent reads the public JWK from data/dev-agent-pubkey.json (volume-mounted by docker-compose.local.yml).
# Enabled by docker-compose.local.yml; leave disabled here to avoid accidental provisioning.
HOMELAB_DEV_SEED="false"

# Start management profile services (agent, socket-proxy)
COMPOSE_PROFILES="management"

# Auth (required unless disabled)
DISABLE_AUTH="false"

# OIDC Provider
OIDC_ISSUER_URL="https://pocketid.example.com"
OIDC_CLIENT_ID="homelab-manager"
OIDC_REDIRECT_URI="http://localhost:3000/api/auth/callback"

# Session
SESSION_TTL_HOURS="8"

# Role Mapping (OIDC group name -> role)
OIDC_ROLE_ADMIN="homelab-admins"
OIDC_ROLE_OPERATOR="homelab-operators"
OIDC_ROLE_VIEWER="homelab-viewers"
