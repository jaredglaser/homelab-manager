# See docs/development.md for full setup instructions.

# PostgreSQL
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
POSTGRES_DB="homelab"
POSTGRES_USER="homelab"
POSTGRES_PASSWORD="changeme"
POSTGRES_SSL="false"
POSTGRES_POOL_SIZE="10"

# Web Server
WEB_PORT="3000"

# Background Worker
WORKER_ENABLED="true"
WORKER_DOCKER_ENABLED="true"
WORKER_ZFS_ENABLED="false"
WORKER_PROXMOX_ENABLED="false"
WORKER_COLLECTION_INTERVAL_MS="1000"
WORKER_BATCH_SIZE="10"
WORKER_BATCH_TIMEOUT_MS="1000"

# Docker Host (supports multiple: _1, _2, _3)
# Use "socket-proxy" when using the agent overlay (docker-compose.agent.yml)
# Use an IP or hostname when connecting to a remote socket proxy
DOCKER_HOST_1="socket-proxy"
DOCKER_HOST_PORT_1="2375"
DOCKER_HOST_NAME_1="dev-machine"

# ZFS Host (supports multiple: _1, _2, _3)
# ZFS_HOST_1=""
# ZFS_HOST_PORT_1="22"
# ZFS_HOST_NAME_1=""
# ZFS_HOST_USER_1=""
# ZFS_HOST_PASSWORD_1=""
# ZFS_HOST_KEY_PATH_1=""
# ZFS_HOST_KEY_PASSPHRASE_1=""

# Proxmox VE API
# Token format: USER@REALM!TOKENID (e.g., root@pam!monitoring)
# PROXMOX_HOST=""
# PROXMOX_PORT="8006"
# PROXMOX_TOKEN_ID=""
# PROXMOX_TOKEN_SECRET=""
# PROXMOX_ALLOW_SELF_SIGNED="true"

# Docker Stack Management
DOCKER_MANAGEMENT_FEATURE_FLAG="true"
VITE_DOCKER_MANAGEMENT_FEATURE_FLAG="true"
GIT_REPOS_DIR="./data/repos"
GIT_SERVER_TOKEN="dev-git-token"

# Dev Agent (auto-seeded when DOCKER_MANAGEMENT_FEATURE_FLAG is set)
DEV_AGENT_TOKEN="dev-agent-token"

# OpenBao (secrets management)
# Use localhost for local dev (bun dev runs outside Docker).
# Docker services override this to "http://openbao:8200" internally.
OPENBAO_URL="http://localhost:8200"
OPENBAO_TOKEN="dev-root-token"

# Start management profile services (agent, socket-proxy, OpenBao)
COMPOSE_PROFILES="management"
