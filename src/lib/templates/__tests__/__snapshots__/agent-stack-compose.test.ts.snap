// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`generateAgentStackCompose generates correct YAML for Docker-only host 1`] = `
"# homelab-manager agent stack
# Generated by homelab-manager UI
services:
  socket-proxy:
    image: lscr.io/linuxserver/socket-proxy:latest
    container_name: hlm-socket-proxy
    restart: unless-stopped
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
    environment:
      CONTAINERS: 1
      EVENTS: 1
      INFO: 1
      IMAGES: 1
      ALLOW_LOGS: 1
      NETWORKS: 1
      VOLUMES: 1
      VERSION: 1
      ALLOW_START: 1
      ALLOW_STOP: 1
      ALLOW_RESTARTS: 1
      POST: 1
      EXEC: 1
      CONTAINERS_CREATE: 1
      CONTAINERS_DELETE: 1
    networks:
      - agent-internal
  stacks-dir-init:
    image: \${AGENT_IMAGE}
    user: "0:0"
    restart: "no"
    working_dir: /opt/homelab-manager/stacks
    entrypoint:
      - sh
      - -c
      - |
        can_use() { setpriv --reuid=agent --regid=agent --clear-groups test -r "$$1" -a -w "$$1" -a -x "$$1"; }
        warn() { echo "Could not give the agent (agent:agent) read and write access to $$1. Fix its ownership on the host." >&2; }

        if ! can_use .; then
          chown agent:agent . && chmod u+rwx . || warn "/opt/homelab-manager/stacks"
        fi
        if [ -d hlm-agent-tls ] && ! can_use hlm-agent-tls; then
          chown -R agent:agent hlm-agent-tls && chmod u+rwx hlm-agent-tls || warn "/opt/homelab-manager/stacks/hlm-agent-tls"
        fi
        exit 0
    volumes:
      - \${HLM_STACKS_DIR:-/opt/homelab-manager/stacks}:/opt/homelab-manager/stacks
    network_mode: none
    labels:
      - hlm.managed=true
      - hlm.role=agent-init
  agent:
    image: \${AGENT_IMAGE}
    container_name: hlm-agent
    restart: unless-stopped
    ports:
      - \${HLM_AGENT_PORT:-9090}:9090
    environment:
      AGENT_TRUSTED_PUBKEY: \${AGENT_TRUSTED_PUBKEY}
      AGENT_HOST_NAME: test-host
      AGENT_IMAGE: \${AGENT_IMAGE}
      AGENT_CONTAINER_NAME: hlm-agent
      TLS_CERT_PATH: /opt/homelab-manager/stacks/hlm-agent-tls/cert.pem
      TLS_KEY_PATH: /opt/homelab-manager/stacks/hlm-agent-tls/key.pem
      DOCKER_HOST: tcp://socket-proxy:2375
    volumes:
      - \${HLM_STACKS_DIR:-/opt/homelab-manager/stacks}:/opt/homelab-manager/stacks
    networks:
      - agent-internal
      - agent-public
    depends_on:
      stacks-dir-init:
        condition: service_completed_successfully
      socket-proxy:
        condition: service_started
    labels:
      - hlm.managed=true
      - hlm.role=agent
networks:
  agent-internal:
    driver: bridge
    internal: true
  agent-public:
    driver: bridge
"
`;

exports[`generateAgentStackCompose generates correct YAML for ZFS-only host 1`] = `
"# homelab-manager agent stack
# Generated by homelab-manager UI
services:
  stacks-dir-init:
    image: \${AGENT_IMAGE}
    user: "0:0"
    restart: "no"
    working_dir: /opt/homelab-manager/stacks
    entrypoint:
      - sh
      - -c
      - |
        can_use() { setpriv --reuid=\${HLM_ZFS_UID} --regid=\${HLM_ZFS_GID} --clear-groups test -r "$$1" -a -w "$$1" -a -x "$$1"; }
        warn() { echo "Could not give the agent (\${HLM_ZFS_UID}:\${HLM_ZFS_GID}) read and write access to $$1. Fix its ownership on the host." >&2; }

        if ! can_use .; then
          chown \${HLM_ZFS_UID}:\${HLM_ZFS_GID} . && chmod u+rwx . || warn "/opt/homelab-manager/stacks"
        fi
        if [ -d hlm-agent-tls ] && ! can_use hlm-agent-tls; then
          chown -R \${HLM_ZFS_UID}:\${HLM_ZFS_GID} hlm-agent-tls && chmod u+rwx hlm-agent-tls || warn "/opt/homelab-manager/stacks/hlm-agent-tls"
        fi
        exit 0
    volumes:
      - \${HLM_STACKS_DIR:-/opt/homelab-manager/stacks}:/opt/homelab-manager/stacks
    network_mode: none
    labels:
      - hlm.managed=true
      - hlm.role=agent-init
  agent:
    image: \${AGENT_IMAGE}
    container_name: hlm-agent
    restart: unless-stopped
    ports:
      - \${HLM_AGENT_PORT:-9090}:9090
    environment:
      AGENT_TRUSTED_PUBKEY: \${AGENT_TRUSTED_PUBKEY}
      AGENT_HOST_NAME: test-host
      AGENT_IMAGE: \${AGENT_IMAGE}
      AGENT_CONTAINER_NAME: hlm-agent
      TLS_CERT_PATH: /opt/homelab-manager/stacks/hlm-agent-tls/cert.pem
      TLS_KEY_PATH: /opt/homelab-manager/stacks/hlm-agent-tls/key.pem
    volumes:
      - \${HLM_STACKS_DIR:-/opt/homelab-manager/stacks}:/opt/homelab-manager/stacks
      - /usr/sbin/zpool:/usr/sbin/zpool:ro
      - /usr/sbin/zfs:/usr/sbin/zfs:ro
      - /dev/zfs:/dev/zfs
    user: \${HLM_ZFS_UID}:\${HLM_ZFS_GID}
    depends_on:
      stacks-dir-init:
        condition: service_completed_successfully
    labels:
      - hlm.managed=true
      - hlm.role=agent
"
`;

exports[`generateAgentStackCompose generates full stack YAML for Docker + ZFS host 1`] = `
"# homelab-manager agent stack
# Generated by homelab-manager UI
services:
  socket-proxy:
    image: lscr.io/linuxserver/socket-proxy:latest
    container_name: hlm-socket-proxy
    restart: unless-stopped
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
    environment:
      CONTAINERS: 1
      EVENTS: 1
      INFO: 1
      IMAGES: 1
      ALLOW_LOGS: 1
      NETWORKS: 1
      VOLUMES: 1
      VERSION: 1
      ALLOW_START: 1
      ALLOW_STOP: 1
      ALLOW_RESTARTS: 1
      POST: 1
      EXEC: 1
      CONTAINERS_CREATE: 1
      CONTAINERS_DELETE: 1
    networks:
      - agent-internal
  stacks-dir-init:
    image: \${AGENT_IMAGE}
    user: "0:0"
    restart: "no"
    working_dir: /opt/homelab-manager/stacks
    entrypoint:
      - sh
      - -c
      - |
        can_use() { setpriv --reuid=\${HLM_ZFS_UID} --regid=\${HLM_ZFS_GID} --groups=\${DOCKER_GID} test -r "$$1" -a -w "$$1" -a -x "$$1"; }
        warn() { echo "Could not give the agent (\${HLM_ZFS_UID}:\${HLM_ZFS_GID}) read and write access to $$1. Fix its ownership on the host." >&2; }

        if ! can_use .; then
          chown \${HLM_ZFS_UID}:\${HLM_ZFS_GID} . && chmod u+rwx . || warn "/opt/homelab-manager/stacks"
        fi
        if [ -d hlm-agent-tls ] && ! can_use hlm-agent-tls; then
          chown -R \${HLM_ZFS_UID}:\${HLM_ZFS_GID} hlm-agent-tls && chmod u+rwx hlm-agent-tls || warn "/opt/homelab-manager/stacks/hlm-agent-tls"
        fi
        exit 0
    volumes:
      - \${HLM_STACKS_DIR:-/opt/homelab-manager/stacks}:/opt/homelab-manager/stacks
    network_mode: none
    labels:
      - hlm.managed=true
      - hlm.role=agent-init
  agent:
    image: \${AGENT_IMAGE}
    container_name: hlm-agent
    restart: unless-stopped
    ports:
      - \${HLM_AGENT_PORT:-9090}:9090
    environment:
      AGENT_TRUSTED_PUBKEY: \${AGENT_TRUSTED_PUBKEY}
      AGENT_HOST_NAME: test-host
      AGENT_IMAGE: \${AGENT_IMAGE}
      AGENT_CONTAINER_NAME: hlm-agent
      TLS_CERT_PATH: /opt/homelab-manager/stacks/hlm-agent-tls/cert.pem
      TLS_KEY_PATH: /opt/homelab-manager/stacks/hlm-agent-tls/key.pem
      DOCKER_HOST: tcp://socket-proxy:2375
    volumes:
      - \${HLM_STACKS_DIR:-/opt/homelab-manager/stacks}:/opt/homelab-manager/stacks
      - /usr/sbin/zpool:/usr/sbin/zpool:ro
      - /usr/sbin/zfs:/usr/sbin/zfs:ro
      - /dev/zfs:/dev/zfs
    user: \${HLM_ZFS_UID}:\${HLM_ZFS_GID}
    group_add:
      - \${DOCKER_GID}
    networks:
      - agent-internal
      - agent-public
    depends_on:
      stacks-dir-init:
        condition: service_completed_successfully
      socket-proxy:
        condition: service_started
    labels:
      - hlm.managed=true
      - hlm.role=agent
networks:
  agent-internal:
    driver: bridge
    internal: true
  agent-public:
    driver: bridge
"
`;

exports[`generateAgentStackEnv generates env for Docker-only host 1`] = `
"AGENT_IMAGE=ghcr.io/jaredglaser/homelab-manager-agent:latest
HLM_AGENT_PORT=9090
HLM_STACKS_DIR=/opt/homelab-manager/stacks
AGENT_TRUSTED_PUBKEY={"kty":"OKP","crv":"Ed25519","x":"test-x-value"}
"
`;

